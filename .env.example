# Lead Sniper Environment Variables
# Copy this file to .env and fill in your actual values:

# 1. Target Repository to monitor (Use your own custom test repo for easy testing)
REPO_OWNER=your-github-username
REPO_NAME=lead-sniper-test

# 2. GitHub Personal Access Token (Free, 0 permissions needed for public repos)
# Increases rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# 3. Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# 4. Discord Webhook URL (Create in any Discord channel -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=
